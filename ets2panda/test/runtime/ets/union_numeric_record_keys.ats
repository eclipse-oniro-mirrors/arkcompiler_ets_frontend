// Record keys with a union key type: an integer literal key resolves via unique widening
// to the numeric member of the key union (`string|number` widens int to the number member).

function main(): void {
    let r: Record<string|number, bigint> = {
        "A": 1n,
        "B": 2n,
        1: 100n,
        2: 200n,
    };
    arktest.assertTrue(r["A"] == 1n && r["B"] == 2n);
    arktest.assertTrue(r[1] == 100n && r[2] == 200n);
    r[3] = 300n;
    arktest.assertTrue(r[3] == 300n);
    arktest.assertTrue(r["C"] == undefined && r[4] == undefined);
}
