// Floating-point literals: default inferred type matches a union member → exact match.
// These were already OK before the change — verify they remain OK with correct type.

function main(): void {
    // float|double with double literal (1.0): default type is double, in union → OK (double)
    let a1: float | double = 1.0
    arktest.assertTrue(a1 instanceof double)

    // float|double with float literal (1.0f): default type is float, in union → OK (float)
    let b1: float | double = 1.0f
    arktest.assertTrue(b1 instanceof float)

    // int|double with double literal: default type is double, in union → OK (double)
    let c1: int | double = 1.0
    arktest.assertTrue(c1 instanceof double)

    // int|float with float literal: default type is float, in union → OK (float)
    let d1: int | float = 1.0f
    arktest.assertTrue(d1 instanceof float)

    // byte|double with double literal: default type is double, in union → OK (double)
    let e1: byte | double = 1.0
    arktest.assertTrue(e1 instanceof double)

    // long|double with double literal: default type is double, in union → OK (double)
    let f1: long | double = 1.0
    arktest.assertTrue(f1 instanceof double)
}
