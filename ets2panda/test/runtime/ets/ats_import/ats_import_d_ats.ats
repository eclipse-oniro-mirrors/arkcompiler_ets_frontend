// Import resolution must hit ats_decl.d.ats as a declaration module (SOURCE_DECL).
// The ambient type is kept out of runtime signatures: only erased local annotations use it.

import { Point } from "./ats_decl";

function main(): void {
    let p: Point | null = null;
    arktest.assertTrue(p === null);
}
