interface I {
    a: string
}

class B1 {
    a: string = "s"
}

class B2 extends B1 {
    a: string = "m"
}

class B3 extends B2 implements I { }

function readViaIface(x: I): string {
    return x.a
}

function main() {
    let x = new B3()
    arktest.assertEQ(x.a, "m")
    x.a = "z"
    arktest.assertEQ(x.a, "z")
    arktest.assertEQ(readViaIface(x), "z")
}
