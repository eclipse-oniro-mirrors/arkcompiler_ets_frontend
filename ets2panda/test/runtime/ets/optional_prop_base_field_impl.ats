interface I {
    a?: string
}

class Base {
    a?: string = "init"
}

class Klass extends Base implements I { }

function readViaIface(x: I): string | undefined {
    return x.a
}

function writeViaIface(x: I) {
    x.a = "w"
}

function main() {
    let k = new Klass()
    // Reads must reach the inherited field storage, not the interface default accessor.
    arktest.assertEQ(k.a, "init")
    k.a = "x"
    arktest.assertEQ(k.a, "x")
    // Interface-typed references must dispatch to the class accessors backed by the field.
    arktest.assertEQ(readViaIface(k), "x")
    writeViaIface(k)
    arktest.assertEQ(k.a, "w")
}
