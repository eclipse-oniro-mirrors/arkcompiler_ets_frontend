// Runtime type verification: unique widening must produce the widened type at runtime,
// not the literal's default type. E.g. number|undefined = 10 must store Double, not Int.

class Msg {
    public numOptional: number | undefined = 10;
    public longOptional: long | undefined = 1;
    public floatOptional: float | undefined = 1;
}

function main(): void {
    // Class property with optional number (number = double)
    let m = new Msg();
    arktest.assertTrue(m.numOptional instanceof double);
    arktest.assertTrue(m.longOptional instanceof long);
    arktest.assertTrue(m.floatOptional instanceof float);

    // Variable declarations with unique widening
    let a: double | undefined = 1;
    arktest.assertTrue(a instanceof double);

    let b: long | undefined = 1;
    arktest.assertTrue(b instanceof long);

    let c: float | undefined = 1;
    arktest.assertTrue(c instanceof float);

    // Exact match keeps original type
    let d: int | long = 1;
    arktest.assertTrue(d instanceof int);

    // Function parameter via unique widening
    arktest.assertTrue(widenDouble(1) instanceof double);
    arktest.assertTrue(widenLong(1) instanceof long);
}

function widenDouble(p: double | undefined): double | undefined { return p }
function widenLong(p: long | undefined): long | undefined { return p }
