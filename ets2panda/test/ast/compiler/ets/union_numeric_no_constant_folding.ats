/* @@? 128:5 Error Semantic error ESE0255: Ambiguous union type operation */
/* @@? 128:5 Error Semantic error ESE0046: Type 'Int' is not compatible with type 'Long|Double' at index 1 */
/* @@? 130:1 Error Semantic error ESE0127: No matching call signature for fp4(Int) */
