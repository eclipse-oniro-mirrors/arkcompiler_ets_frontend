{
  "name": "declgen",
  "version": "1.0.0",
  "description": "Arkts dependency resolver across arkts-sta and arkts-dyn",
  "private": true,
  "main": "dist/entry.js",
  "types": "dist/entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "require": "./dist/entry.js",
      "default": "./dist/entry.js"
    }
  },
  "bin": {
    "declgen-s2d": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "postinstall": "bash ./scripts/install-tsc.sh",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "write-dynamic-impl-hash": "node scripts/write-impl-hash.js",
    "build": "npm run clean && tsc && npm run write-dynamic-impl-hash",
    "build:debug": "npm run clean && tsc -p tsconfig.debug.json && npm run write-dynamic-impl-hash",
    "build:cookbook": "tsc -p tsconfig.cookbook.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "declgen:dynamic-standalone": "node dist/entry.js",
    "test": "npm run test:ut && npm run test:dynamic && npm run test:static",
    "test:ut": "jest test/ut",
    "test:dynamic": "npm run test:dynamic:ut && npm run test:dynamic:cookbook",
    "test:dynamic:ut": "jest test/dynamic/ut",
    "test:dynamic:cookbook": "npm run build:cookbook && node build/cookbook/test/dynamic/framework/cookbookRunner.js --test-dir test/dynamic/cookbook_tests -t ts_source -t dts_declarations -t package_source",
    "test:static": "npm run test:static:ut",
    "test:static:ut": "jest test/static/ut"
  },
  "dependencies": {
    "json5": "2.2.3",
    "commander": "13.1.0",
    "typescript": "npm:ohos-typescript@4.9.5-r9",
    "@es2panda/bindings": "file:../../../bindings",
    "@interop-toolkits/common": "file:../common",
    "dependency-resolver": "file:../dependency-resolver"
  },
  "devDependencies": {
    "@eslint/js": "9.6.0",
    "@types/jest": "29.5.12",
    "@types/node": "22.10.7",
    "eslint": "9.6.0",
    "jest": "29.7.0",
    "prettier": "3.5.2",
    "ts-jest": "29.4.11",
    "jest-diff": "^30.2.0",
    "kleur": "^4.1.5",
    "typescript-eslint": "8.55.0"
  }
}
