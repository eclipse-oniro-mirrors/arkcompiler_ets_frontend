# Install the prebuilt common tarball into declgen's node_modules.
action("install_common_pkg") {
  script = "../ci-build/install_pkg.py"
  inputs = [
    "../ci-build/install_pkg.py",
    "$_common_tgz",
  ]
  deps = [
    "$_interop_toolkits_label:interop_toolkits_install_tsc",
    "$_common_label:build_common_pkg",
  ]
  outputs =
      [ "$_declgen_workspace/node_modules/@interop-toolkits/common" ]

  args = [
    "--source-path",
    rebase_path("$_declgen_workspace"),
    "--pkg",
    rebase_path("$_common_tgz"),
  ]
}

# Install the prebuilt dependency-resolver tarball into declgen's node_modules.
action("install_dependency_resolver_pkg") {
  script = "../ci-build/install_pkg.py"
  inputs = [
    "../ci-build/install_pkg.py",
    "$_dependency_resolver_tgz",
  ]
  deps = [
    ":install_common_pkg",
    "$_dependency_resolver_label:build_dependency_resolver_pkg",
  ]
  outputs = [ "$_declgen_workspace/node_modules/dependency-resolver" ]

  args = [
    "--source-path",
    rebase_path("$_declgen_workspace"),
    "--pkg",
    rebase_path("$_dependency_resolver_tgz"),
  ]
}

# Install @es2panda/bindings (built from source) into declgen's node_modules.
action("install_bindings_pkg") {
  script = "install_bindings.py"
  inputs = [ "install_bindings.py" ]
  deps = [
    ":install_dependency_resolver_pkg",
    "$_bindings_path:build_bindings(${host_toolchain})",
  ]
  outputs = [ "$_declgen_workspace/node_modules/@es2panda/bindings" ]

  args = [
    "--source-path",
    rebase_path("$_declgen_workspace"),
    "--bindings-path",
    rebase_path("$_bindings_path"),
    "--npm",
    rebase_path(npm_path),
  ]
}

# Build the declgen package and pack it into a tarball.
action("build_declgen_pkg") {
  script = "../ci-build/build_pkg.py"
  inputs = [ "../ci-build/build_pkg.py" ]
  sources = declgen_sources
  deps = [ ":install_bindings_pkg" ]
  outputs = [ "$interop_toolkits_pack_dir/declgen.tgz" ]

  args = [
    "--source-path",
    rebase_path("$_declgen_workspace"),
    "--node-path",
    rebase_path(nodejs_path),
    "--npm-path",
    rebase_path(npm_path),
    "--pack-path",
    rebase_path("$interop_toolkits_pack_dir/declgen.tgz"),
  ]
}
