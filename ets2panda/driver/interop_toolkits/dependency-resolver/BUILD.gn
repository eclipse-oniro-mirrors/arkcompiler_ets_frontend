import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
if ((defined(ark_standalone_build) && ark_standalone_build) ||
    (defined(ark_static_standalone_build) && ark_static_standalone_build)) {
  import("//arkcompiler/runtime_core/static_core/ark_config.gni")
} else {
  import(
      "//build/config/components/runtime_core/static_core/ark_common_config.gni")
}

import("//arkcompiler/ets_frontend/ets2panda/driver/interop_toolkits/workspace.gni")

nodejs_path = "//prebuilts/build-tools/common/nodejs/current/bin/node"
npm_path = "//prebuilts/build-tools/common/nodejs/current/bin/npm"

_interop_toolkits_label =
    "//arkcompiler/ets_frontend/ets2panda/driver/interop_toolkits"
_common_tgz = "$interop_toolkits_pack_dir/common.tgz"

dependency_resolver_sources = [
  "./src/context/context.ts",
  "./src/context/index.ts",
  "./src/entry.ts",
  "./src/errors.ts",
  "./src/logger.ts",
  "./src/resolver/dynamic/dynamicResolver.ts",
  "./src/resolver/dynamic/index.ts",
  "./src/resolver/graph.ts",
  "./src/resolver/index.ts",
  "./src/resolver/partialResolver.ts",
  "./src/resolver/resolver.ts",
  "./src/resolver/static/index.ts",
  "./src/resolver/static/staticResolver.ts",
  "./src/visualize/htmlRenderer.ts",
  "./src/visualize/index.ts",
  "./src/visualize/viewModel.ts",
]

# Install the prebuilt common tarball into dependency-resolver's node_modules.
action("install_common_pkg") {
  script = "../ci-build/install_pkg.py"
  inputs = [
    "../ci-build/install_pkg.py",
    "$_common_tgz",
  ]
  deps = [
    "$_interop_toolkits_label:interop_toolkits_install_tsc",
    "//arkcompiler/ets_frontend/ets2panda/driver/interop_toolkits/common:build_common_pkg",
  ]
  outputs = [
    "$interop_toolkits_workspace_dir/dependency-resolver/node_modules/@interop-toolkits/common",
  ]

  args = [
    "--source-path",
    rebase_path("$interop_toolkits_workspace_dir/dependency-resolver"),
    "--pkg",
    rebase_path("$_common_tgz"),
  ]
}

# Build the dependency-resolver package and pack it into a tarball.
action("build_dependency_resolver_pkg") {
  script = "../ci-build/build_pkg.py"
  inputs = [ "../ci-build/build_pkg.py" ]
  sources = dependency_resolver_sources
  deps = [ ":install_common_pkg" ]
  outputs = [ "$interop_toolkits_pack_dir/dependency-resolver.tgz" ]

  args = [
    "--source-path",
    rebase_path("$interop_toolkits_workspace_dir/dependency-resolver"),
    "--node-path",
    rebase_path(nodejs_path),
    "--npm-path",
    rebase_path(npm_path),
    "--pack-path",
    rebase_path("$interop_toolkits_pack_dir/dependency-resolver.tgz"),
  ]
}
