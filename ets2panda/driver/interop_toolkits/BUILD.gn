import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
if ((defined(ark_standalone_build) && ark_standalone_build) ||
    (defined(ark_static_standalone_build) && ark_static_standalone_build)) {
  import("//arkcompiler/runtime_core/static_core/ark_config.gni")
} else {
  import(
      "//build/config/components/runtime_core/static_core/ark_common_config.gni")
}

if (path_exists("//third_party/typescript")) {
  typescript_dir = "//third_party/typescript"
} else if (defined(ohos_indep_compiler_enable) && ohos_indep_compiler_enable) {
  typescript_dir = "//binarys/third_party/typescript"
}

# Shared workspace path; defined in workspace.gni so common/BUILD.gn can
# resolve the same value (get_path_info(..., "out_dir") is target-independent).
import("workspace.gni")

# Store temporary files for installing ohos-typescript
interop_toolkits_tsc_dir = "$interop_toolkits_workspace_dir/tsc"

# Copy all source files into workspace
action("interop_toolkits_init_workspace") {
  script = "ci-build/copy_workspace.py"
  inputs = [ "ci-build/copy_workspace.py" ]
  outputs = [ interop_toolkits_workspace_dir ]

  args = [
    "--source",
    rebase_path(get_path_info(".", "abspath")),
    "--destination",
    rebase_path(interop_toolkits_workspace_dir),
  ]
}

# Copy gluegen node_modules into packages that have no node_modules
action("interop_toolkits_init_node_modules") {
  script = "ci-build/init_node_modules.py"
  inputs = [ "ci-build/init_node_modules.py" ]
  deps = [ ":interop_toolkits_init_workspace" ]
  outputs = [
    "$interop_toolkits_workspace_dir/common/node_modules",
    "$interop_toolkits_workspace_dir/declgen/node_modules",
    "$interop_toolkits_workspace_dir/dependency-resolver/node_modules",
  ]

  args = [
    "--workspace",
    rebase_path(interop_toolkits_workspace_dir),
    "--from",
    "gluegen",
    "--to",
    "common",
    "declgen",
    "dependency-resolver",
  ]
}

# Install ohos-typescript as the "typescript" module into the packages
# that depend on it but have no node_modules of their own
action("interop_toolkits_install_tsc") {
  script = "ci-build/compile_declgen.sh"
  inputs = [ "ci-build/compile_declgen.sh" ]
  deps = [ ":interop_toolkits_init_node_modules" ]
  outputs = [
    "$interop_toolkits_workspace_dir/dependency-resolver/node_modules/typescript",
    "$interop_toolkits_workspace_dir/declgen/node_modules/typescript",
  ]

  args = [
    rebase_path(typescript_dir),
    rebase_path(interop_toolkits_tsc_dir),
    rebase_path("$interop_toolkits_workspace_dir/dependency-resolver"),
    rebase_path("$interop_toolkits_workspace_dir/declgen"),
  ]
}

# Collect the built gluegen, dependency-resolver and declgen packages into
# the artifacts directory. Only the package.json "files" entries (plus
# package.json) and the whitelisted node_modules entries are copied.
action("interop_toolkits_collect_artifacts") {
  script = "ci-build/copy_pkg.py"
  inputs = [
    "ci-build/copy_pkg.py",
    "ci-build/node_modules_whitelist.json",
  ]
  deps = [
    "common:build_common_pkg",
    "gluegen:build_gluegen_pkg",
    "dependency-resolver:build_dependency_resolver_pkg",
    "declgen:build_declgen_pkg",
  ]
  outputs = [
    interop_toolkits_artifacts_dir
  ]

  args = [
    "--workspace",
    rebase_path(interop_toolkits_workspace_dir),
    "--dest",
    rebase_path(interop_toolkits_artifacts_dir),
    "--whitelist",
    rebase_path("ci-build/node_modules_whitelist.json"),
    "gluegen",
    "dependency-resolver",
    "declgen",
  ]
}

ohos_copy("ets2panda_interop_toolkits") {
  deps = [ ":interop_toolkits_collect_artifacts" ]
  sources = [ rebase_path(interop_toolkits_artifacts_dir) ]
  outputs = [ "$target_out_dir/interop_toolkits" ]

  module_source_dir = "$target_out_dir/interop_toolkits"
  module_install_name = ""
  part_name = "ets_frontend"
  subsystem_name = "arkcompiler"
}
