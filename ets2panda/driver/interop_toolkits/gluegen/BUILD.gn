import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
if ((defined(ark_standalone_build) && ark_standalone_build) ||
    (defined(ark_static_standalone_build) && ark_static_standalone_build)) {
  import("//arkcompiler/runtime_core/static_core/ark_config.gni")
} else {
  import(
      "//build/config/components/runtime_core/static_core/ark_common_config.gni")
}

import("//arkcompiler/ets_frontend/ets2panda/driver/interop_toolkits/workspace.gni")

_interop_toolkits_label =
    "//arkcompiler/ets_frontend/ets2panda/driver/interop_toolkits"

nodejs_path = "//prebuilts/build-tools/common/nodejs/current/bin/node"
npm_path = "//prebuilts/build-tools/common/nodejs/current/bin/npm"

gluegen_native_output_name = "gluegen"
gluegen_native_output =
    "$root_out_dir/arkcompiler/ets_frontend/$gluegen_native_output_name"
gluegen_native_name = gluegen_native_output_name
if (is_mingw) {
  gluegen_native_output += ".exe"
  gluegen_native_name += ".exe"
}
_gluegen_workspace_dir = "$interop_toolkits_workspace_dir/gluegen"
_gluegen_workspace_native = "$_gluegen_workspace_dir/bin/$gluegen_native_name"

gluegen_sources = [
  "./src/cli.ts",
  "./src/contracts/buildConfig.ts",
  "./src/contracts/index.ts",
  "./src/contracts/report.ts",
  "./src/entry.ts",
  "./src/errors.ts",
  "./src/logger.ts",
  "./src/native/index.ts",
  "./src/native/invocation.ts",
  "./src/native/process.ts",
  "./src/native/report.ts",
  "./src/pipeline/artifact.ts",
  "./src/pipeline/context.ts",
  "./src/pipeline/index.ts",
  "./src/pipeline/pipeline.ts",
  "./src/pipeline/runner.ts",
  "./src/pipeline/stage.ts",
  "./src/stages/arktsconfig/arktsconfig.ts",
  "./src/stages/arktsconfig/buildArkTSConfig.ts",
  "./src/stages/arktsconfig/generateArkTSConfig.ts",
  "./src/stages/arktsconfig/index.ts",
  "./src/stages/arktsconfig/rules/arktsconfigRule.ts",
  "./src/stages/arktsconfig/rules/externalSdkRule.ts",
  "./src/stages/arktsconfig/rules/interopSdkRule.ts",
  "./src/stages/arktsconfig/rules/moduleRule.ts",
  "./src/stages/arktsconfig/rules/ruleOutput.ts",
  "./src/stages/arktsconfig/rules/stdlibRule.ts",
  "./src/stages/configuration/configurationResult.ts",
  "./src/stages/configuration/index.ts",
  "./src/stages/configuration/interopTarget.ts",
  "./src/stages/configuration/moduleConfig.ts",
  "./src/stages/configuration/moduleTable.ts",
  "./src/stages/configuration/resolveInteropConfig.ts",
  "./src/stages/configuration/resolveModules.ts",
  "./src/stages/configuration/validate.ts",
  "./src/stages/generation/index.ts",
  "./src/stages/generation/runNative.ts",
  "./src/stages/prepare/generateInteropFileList.ts",
  "./src/stages/prepare/index.ts",
  "./src/stages/stageArtifacts.ts",
  "./src/utils/fileTree.ts",
  "./src/utils/staticSource.ts",
]

ohos_executable("gluegen_native") {
  sources = [
    "native/src/cli.cpp",
    "native/src/diagnostic.cpp",
    "native/src/gluec.cpp",
    "native/src/gluegen.cpp",
    "native/src/gluel.cpp",
    "native/src/main.cpp",
    "native/src/symbol.cpp",
    "native/src/utils.cpp",
  ]

  output_name = gluegen_native_output_name

  include_dirs = [
    "native/include",
    "$target_gen_dir",
  ]

  if ((defined(ark_standalone_build) && ark_standalone_build) ||
      (defined(ark_static_standalone_build) && ark_static_standalone_build)) {
    configs = [ "$ark_root:ark_config" ]
  } else {
    configs = [
      "//build/config/components/runtime_core/static_core:ark_common_config",
    ]
  }
  configs += [ "$ark_es2panda_root:libes2panda_public_config" ]

  deps = [
    "$ark_es2panda_root:libes2panda_frontend_static",
    "$ark_es2panda_root:libes2panda_public_frontend_static",
  ]

  if (ark_standalone_build) {
    deps += [
      "$ark_root/bytecode_optimizer:libarktsbytecodeopt_package",
      "$ark_root/libarkbase:libarktsbase_package",
      "$ark_root/libarkfile:libarktsfile_package",
    ]
  }

  external_deps = [
    "json:nlohmann_json_static",
    "runtime_core:assembler_headers",
    "runtime_core:libarktsassembler_package",
    "runtime_core:libarktsbase_package",
    "runtime_core:libarktsbytecodeopt_package",
    "runtime_core:libarktscompiler_package",
    "runtime_core:libarktsfile_package",
    "runtime_core:libpandabase_headers",
    "runtime_core:libpandafile_headers",
    sdk_libc_secshared_dep,
  ]

  use_exceptions = true
  libs = platform_libs
  ldflags = platform_ldflags
  if (is_linux) {
    libs += [ "stdc++fs" ]
  }

  # Internal tool: not part of the publicly shipped SDK surface.
  install_enable = false
  part_name = "ets_frontend"
  subsystem_name = "arkcompiler"
}

# Copy the built gluegen_native executable into the workspace gluegen/bin.
action("copy_gluegen_native_to_workspace") {
  script = "scripts/copy_gluegen_native.py"
  inputs = [ gluegen_native_output ]
  deps = [
    ":gluegen_native",
    "$_interop_toolkits_label:interop_toolkits_init_workspace",
  ]
  outputs = [ _gluegen_workspace_native ]

  args = [
    "--source",
    rebase_path(gluegen_native_output),
    "--destination",
    rebase_path(_gluegen_workspace_native),
  ]
}

# Build the gluegen package inside the workspace and pack it into a tarball.
action("build_gluegen_pkg") {
  script = "../ci-build/build_pkg.py"
  inputs = [ "../ci-build/build_pkg.py" ]
  sources = gluegen_sources
  deps = [ ":copy_gluegen_native_to_workspace" ]
  outputs = [ "$interop_toolkits_pack_dir/gluegen.tgz" ]

  args = [
    "--source-path",
    rebase_path(_gluegen_workspace_dir),
    "--node-path",
    rebase_path(nodejs_path),
    "--npm-path",
    rebase_path(npm_path),
    "--pack-path",
    rebase_path("$interop_toolkits_pack_dir/gluegen.tgz"),
  ]
}
