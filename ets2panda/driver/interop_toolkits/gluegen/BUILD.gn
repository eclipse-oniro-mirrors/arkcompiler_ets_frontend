import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
if ((defined(ark_standalone_build) && ark_standalone_build) ||
    (defined(ark_static_standalone_build) && ark_static_standalone_build)) {
  import("//arkcompiler/runtime_core/static_core/ark_config.gni")
} else {
  import(
      "//build/config/components/runtime_core/static_core/ark_common_config.gni")
}

nodejs_path = "${node_path}/node"
npm_path = "${node_path}/npm"
gluegen_output_dir = "$target_gen_dir/gluegen"

gluegen_wrapper_sources = [
  "./src/cli.ts",
  "./src/contracts/buildConfig.ts",
  "./src/contracts/index.ts",
  "./src/contracts/report.ts",
  "./src/entry.ts",
  "./src/errors.ts",
  "./src/logger.ts",
  "./src/native/index.ts",
  "./src/native/invocation.ts",
  "./src/native/process.ts",
  "./src/native/report.ts",
  "./src/pipeline/artifact.ts",
  "./src/pipeline/context.ts",
  "./src/pipeline/index.ts",
  "./src/pipeline/pipeline.ts",
  "./src/pipeline/runner.ts",
  "./src/pipeline/stage.ts",
  "./src/stages/arktsconfig/arktsconfig.ts",
  "./src/stages/arktsconfig/buildArkTSConfig.ts",
  "./src/stages/arktsconfig/generateArkTSConfig.ts",
  "./src/stages/arktsconfig/index.ts",
  "./src/stages/arktsconfig/rules/arktsconfigRule.ts",
  "./src/stages/arktsconfig/rules/externalSdkRule.ts",
  "./src/stages/arktsconfig/rules/interopSdkRule.ts",
  "./src/stages/arktsconfig/rules/moduleRule.ts",
  "./src/stages/arktsconfig/rules/ruleOutput.ts",
  "./src/stages/arktsconfig/rules/stdlibRule.ts",
  "./src/stages/configuration/configurationResult.ts",
  "./src/stages/configuration/index.ts",
  "./src/stages/configuration/interopTarget.ts",
  "./src/stages/configuration/moduleConfig.ts",
  "./src/stages/configuration/moduleTable.ts",
  "./src/stages/configuration/resolveInteropConfig.ts",
  "./src/stages/configuration/resolveModules.ts",
  "./src/stages/configuration/validate.ts",
  "./src/stages/generation/index.ts",
  "./src/stages/generation/runNative.ts",
  "./src/stages/prepare/generateInteropFileList.ts",
  "./src/stages/prepare/index.ts",
  "./src/stages/stageArtifacts.ts",
  "./src/utils/fileTree.ts",
  "./src/utils/staticSource.ts",
]

action("build_gluegen_wrapper") {
  inputs = [
    "build_gluegen_wrapper.py",
    "package-lock.json",
    "package.json",
    "tsconfig.json",
  ]
  sources = gluegen_wrapper_sources
  script = "build_gluegen_wrapper.py"

  args = [
    "--source-path",
    rebase_path(get_path_info(".", "abspath")),
    "--work-dir",
    rebase_path(target_out_dir),
    "--output-path",
    rebase_path(gluegen_output_dir),
    "--npm",
    rebase_path(npm_path),
    "--node",
    rebase_path(nodejs_path),
  ]

  outputs = [ gluegen_output_dir ]
}

ohos_copy("ets2panda_build_gluegen") {
  deps = [ ":build_gluegen_wrapper" ]
  sources = [ rebase_path(gluegen_output_dir) ]
  outputs = [ "$target_out_dir/gluegen" ]
  module_source_dir = "$target_out_dir/gluegen"
  module_install_name = ""
  part_name = "ets_frontend"
  subsystem_name = "arkcompiler"
}

ohos_executable("gluegen_native") {
  sources = []
  output_name = "gluegen"
  include_dirs = []
}
