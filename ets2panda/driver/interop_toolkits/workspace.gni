# Target-independent shared paths (avoid $target_out_dir/$target_gen_dir:
# they differ per importing target).
_interop_toolkits_dir = "//arkcompiler/ets_frontend/ets2panda/driver/interop_toolkits"
_interop_toolkits_out_dir = get_path_info(_interop_toolkits_dir, "out_dir")
_interop_toolkits_gen_dir = get_path_info(_interop_toolkits_dir, "gen_dir")

# Store source files and intermediate artifacts
interop_toolkits_workspace_dir =
    "$_interop_toolkits_gen_dir/interop_toolkits_workspace"
# Store final artifacts for interop_toolkits
interop_toolkits_artifacts_dir =
    "$_interop_toolkits_out_dir/interop_toolkits_artifacts"
# Store temporary packs
interop_toolkits_pack_dir =
    "$interop_toolkits_workspace_dir/pack"
