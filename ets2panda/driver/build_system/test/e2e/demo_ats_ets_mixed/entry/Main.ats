import { legacyPackage } from 'legacy';
import { legacyValue } from 'legacy/value.ets';
import { message } from 'library';
import { indexSubpath } from 'library/Index';
import { message as explicitEntry } from 'library/src/Api.ats';
import { Value } from 'library/value';
import { Value as ExplicitValue } from 'library/value.ats';
import { Value as RootValue } from 'library/src/value.ats';
import { selectedTarget } from 'library/choice';
import { fallback } from 'library/fallback';
import { lowerIndex } from 'library/lower';
import { upperIndex } from 'library/upper';
import { fileAfterDirectory } from 'library/directoryFallback';
import { rootValue } from 'library/rootValue';
import { tool } from '@scope/tools';
import { tool as explicitTool } from '@scope/tools/Utility.ats';

// Different import spellings must resolve to the same class, including its private member.
function sameModule(value: Value): string {
  const explicit: ExplicitValue = value;
  const fromRoot: RootValue = explicit;
  return fromRoot.text();
}

export function entry(): string {
  return legacyPackage() + legacyValue() + message() + indexSubpath() + explicitEntry() + sameModule(new Value()) +
    selectedTarget() + fallback() + lowerIndex() + upperIndex() + fileAfterDirectory() +
    rootValue() + tool() + explicitTool();
}
